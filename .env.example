# Supabase (public keys are safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server only. Google Gemini API key used by /api/parse-report.
MIKISAI_GEMINI_KEY=your-gemini-api-key
# Optional. Defaults to gemini-3.6-flash.
# MIKISAI_GEMINI_MODEL=gemini-3.6-flash
# Seed script only: initial passwords for the two founders
SEED_MIKE_EMAIL=mike@example.com
SEED_MIKE_PASSWORD=change-me-mike
SEED_SAI_EMAIL=sai@example.com
SEED_SAI_PASSWORD=change-me-sai

# Random string; Vercel sends it as a Bearer token with the daily data health cron (Settings > Environment Variables).
CRON_SECRET=

# TikTok Shop Open API (Partner Center app). Server only. See /more/connect-tiktok.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Optional: the app's service id; when set the authorize link uses services.tiktokshop.com.
TIKTOK_SERVICE_ID=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the shop tokens at rest.
TIKTOK_TOKEN_KEY=
# Optional, for local runs against scripts/tiktok-mock-server.ts only.
# TIKTOK_API_BASE=http://127.0.0.1:4545
# TIKTOK_AUTH_BASE=http://127.0.0.1:4545
